# Backend base URL. Leave empty (or set VITE_DEMO=true) to run on the built-in demo data.
VITE_API_URL=http://localhost:8000

# true = no backend needed: every screen runs on clearly labelled sample data in the browser.
VITE_DEMO=false

# Same OAuth client ID as the backend's GOOGLE_CLIENT_ID. Empty = no "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
