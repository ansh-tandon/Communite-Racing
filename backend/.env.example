# Copy to .env and fill in. Never commit .env.

# Local Postgres (pgAdmin's "PostgreSQL 17" server). Tests use <name>_test automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/crql

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated emails that become admins on login.
ADMIN_EMAILS=you@example.com

# Leave empty in dev: login codes are printed in the server log instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Communitie Racing <quiz@mail.communitieracing.in>
# Public URL of the white logo for the email header. Empty = the name in text instead.
EMAIL_LOGO_URL=https://raw.githubusercontent.com/ansh-tandon/Communite-Racing/main/frontend/public/cr-logo-white.png

# OAuth web client ID from Google Cloud (Google Auth Platform -> Clients). Empty = no "Continue with Google".
GOOGLE_CLIENT_ID=

# Comma-separated if the site has more than one address.
FRONTEND_ORIGIN=http://localhost:5173
SENTRY_DSN=

# OpenF1 auto-answers (https://openf1.org). Works without an account: results fill in after each race.
# With a paid account, results also fill in live during the race (provisional until the flag).
OPENF1_USERNAME=
OPENF1_PASSWORD=
# OPENF1_ENABLED=true
# OPENF1_LIVE_INTERVAL_SECONDS=20
