# Copy to .env and fill in. Never commit .env.

# Local Postgres (pgAdmin's "PostgreSQL 17" server). Tests use <name>_test automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/crql

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated emails that become admins on login.
ADMIN_EMAILS=you@example.com

# Leave empty in dev: login codes are printed in the server log instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Communitie Racing <quiz@communitie.racing>

# Comma-separated if the site has more than one address.
FRONTEND_ORIGIN=http://localhost:5173
SENTRY_DSN=
